---
import NavIcon from './NavIcon.astro';

interface FooterLink {
	href: string;
	title: string;
	icon?: string;
	isExternal?: boolean;
}

interface Props {
	social?: {
		title?: string;
		links?: FooterLink[];
	};
	brand?: {
		title?: string;
		description?: string;
	};
	subFooter?: {
		title?: string;
		link?: FooterLink;
	};
}

const { social, brand, subFooter } = Astro.props;
const year = new Date().getFullYear();
const socialLinks = social?.links?.filter((link) => link.href) ?? [];
---

<footer class="footer">
	<div class="footer__columns footer__columns--2">
		<div class="footer__column">
			{social?.title && <h3 class="footer__heading">{social.title}</h3>}
			{
				socialLinks.length > 0 && (
					<div class="footer__links">
						{socialLinks.map((link) => (
							<a
								class="footer__link"
								href={link.href}
								target={link.isExternal ? '_blank' : undefined}
								rel={link.isExternal ? 'noreferrer' : undefined}
							>
								<span class="footer__icon-wrap">
									<NavIcon
										name={link.icon}
										class={link.icon ? `footer__icon footer__icon--${link.icon}` : 'footer__icon'}
									/>
								</span>
								{link.title}
							</a>
						))}
					</div>
				)
			}
		</div>
		<div class="footer__column">
			{brand?.title && <h3 class="footer__heading">{brand.title}</h3>}
			{brand?.description && <p class="footer__text">{brand.description}</p>}
		</div>
	</div>
	{
		subFooter && (
			<div class="footer__sub">
				<div class="footer__sub-inner">
					{subFooter.title && (
						<span class="footer__brand">
							{subFooter.title} &#169; {year}
						</span>
					)}
					{subFooter.link?.href && (
						<>
							<span class="desktop-only"> &#124;</span>
							<a class="footer__legal" href={subFooter.link.href}>
								{subFooter.link.title}
							</a>
						</>
					)}
				</div>
			</div>
		)
	}
</footer>

<style is:global>
	.footer {
		margin: 0 auto;
		width: 100%;
		display: flex;
		flex-direction: column;
		background-color: var(--color-primary-dark);
		padding-bottom: var(--spacing-quintuple);
		border-top: .0625rem solid var(--color-white);
	}

	.footer__column {
		flex: 100%;
		max-width: 100%;
		min-width: 0;
	}

	.footer__column:first-of-type {
		margin-top: var(--spacing-single);
		margin-bottom: var(--spacing-single);
	}

	.footer__columns {
		gap: var(--spacing-single);
		width: 100%;
		display: flex;
		flex-direction: column;
		padding: var(--spacing-double) var(--spacing-half);
	}

	.footer__heading {
		font-weight: 900;
		padding-top: var(--spacing-single);
	}

	.footer__text {
		font-weight: 700;
		padding: var(--spacing-half) 0;
		margin-bottom: var(--spacing-single);
	}

	.footer__links {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-single);
		margin-top: var(--spacing-single);
	}

	.footer__link,
	.footer__legal {
		font-size: 1rem;
		transition: color .3s cubic-bezier(.4, 0, .2, 1);
	}

	.footer__link {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-three-quarters);
		line-height: 1;
	}

	.footer__icon-wrap {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		flex-shrink: 0;
	}

	.footer__icon {
		display: block;
		width: 1.75rem;
		height: 1.75rem;
	}

	.footer__icon--x-logo {
		width: 1.15rem;
		height: 1.15rem;
	}

	.footer__icon path {
		fill: currentColor;
	}

	.footer__link:focus,
	.footer__link:hover,
	.footer__legal:focus,
	.footer__legal:hover {
		color: var(--color-secondary);
	}

	.footer__sub {
		width: 100%;
		padding: var(--spacing-single) var(--spacing-half);
		margin-top: var(--spacing-single);
		border-top: .125rem solid var(--color-white);
	}

	.footer__sub-inner {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-half);
	}

	/* Tablet styles */
	@media (width >= 768px) {
		.footer {
			padding-bottom: var(--spacing-triple);
		}

		.footer__columns {
			flex-direction: row;
			width: 100%;
			max-width: var(--container-desktop);
			margin-left: auto;
			margin-right: auto;
			padding-left: var(--spacing-double);
			padding-right: var(--spacing-double);
		}

		.footer__column:first-of-type {
			margin-top: 0;
			margin-bottom: 0;
		}

		.footer__columns--2 .footer__column {
			max-width: calc(100% / 2);
			flex: 0 0 calc(50% - 1rem);
		}

		.footer__sub {
			width: 100%;
			max-width: var(--container-desktop);
			margin-left: auto;
			margin-right: auto;
			padding-left: var(--spacing-double);
			padding-right: var(--spacing-double);
		}
	}

	/* Desktop styles */
	@media (width >= 1280px) {
		.footer {
			padding-bottom: 0;
			justify-content: center;
		}

		.footer__columns {
			gap: var(--spacing-double);
			padding-top: 0;
			padding-bottom: 0;
		}

		.footer__columns--2 .footer__column {
			flex: 1 1 0;
			max-width: none;
			min-width: 0;
		}

		.footer__sub {
			margin-top: var(--spacing-double);
		}

		.footer__sub-inner {
			flex-direction: row;
			margin: 0 auto;
			max-width: var(--container-desktop);
		}

		.footer__brand {
			padding-right: var(--spacing-half);
		}

		.footer__legal {
			padding-left: var(--spacing-half);
		}
	}
</style>

---
import { icons } from 'virtual:varangian-theme/icons';

interface Props {
	name?: string;
	class?: string;
}

const { name, class: className } = Astro.props;
const Icon = name ? icons[`/src/assets/images/icons/${name}.svg`]?.default : undefined;
---

{Icon && <Icon class={className} width="1.5rem" height="1.5rem" aria-hidden="true" />}

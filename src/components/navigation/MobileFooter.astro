---
import NavIcon from './NavIcon.astro';
import { isCurrentPath } from '../../lib/path';

interface MobileLink {
	href: string;
	title: string;
	icon?: string;
}

interface Props {
	links?: MobileLink[];
}

const PRIMARY_PAGES = 3;
const { links = [] } = Astro.props;
const path = Astro.url.pathname;
const primary = links.slice(0, PRIMARY_PAGES);
const extra = links.slice(PRIMARY_PAGES);
const itemCount = primary.length + (extra.length > 0 ? 1 : 0);
---

{
	primary.length > 0 && (
		<>
			{
				extra.length > 0 && (
					<div
						class="mobile-nav__sidebar"
						id="mobile-sidebar"
						data-mobile-sidebar
						role="dialog"
						aria-label="Menu"
						aria-hidden="true"
					>
						<ul class="mobile-nav__list">
							{extra.map((link) => {
								const current = isCurrentPath(path, link.href);
								return (
									<li class="mobile-nav__item">
										<a
											class:list={[
												'mobile-nav__sidebar-link',
												{ 'mobile-nav__link--active': current },
											]}
											href={link.href}
											aria-current={current ? 'page' : undefined}
											data-close-menu
										>
											{link.title}
										</a>
									</li>
								);
							})}
						</ul>
					</div>
				)
			}
			<footer
				class="mobile-nav"
				data-mobile-footer
				style={`--mobile-nav-count: ${itemCount}`}
			>
				<div class="mobile-nav__bar">
					{
						primary.map((link) => {
							const current = isCurrentPath(path, link.href);
							return (
							<a
								class:list={['mobile-nav__link', { 'mobile-nav__link--active': current }]}
								href={link.href}
								aria-current={current ? 'page' : undefined}
								data-close-menu
							>
								{
									link.icon && (
										<span class="mobile-nav__icon">
											<NavIcon name={link.icon} class="mobile-nav__glyph" />
										</span>
									)
								}
								<span class="mobile-nav__label">{link.title}</span>
							</a>
							);
						})
					}
					{
						extra.length > 0 && (
							<button
								class="mobile-nav__toggle"
								type="button"
								data-menu-toggle
								aria-expanded="false"
								aria-controls="mobile-sidebar"
							>
								<span class="mobile-nav__icon" aria-hidden="true">
									<svg
										class="mobile-nav__icon-open"
										viewBox="0 0 24 24"
										width="1.875rem"
										height="1.875rem"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
									>
										<path d="M4 7h16M4 12h16M4 17h16"></path>
									</svg>
									<svg
										class="mobile-nav__icon-close"
										viewBox="0 0 24 24"
										width="1.875rem"
										height="1.875rem"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										hidden
									>
										<path d="M6 6l12 12M18 6L6 18"></path>
									</svg>
								</span>
								<span class="mobile-nav__label" data-menu-label>Menu</span>
							</button>
						)
					}
				</div>
			</footer>
		</>
	)
}

<script>
	function initMobileFooter() {
		const footer = document.querySelector('[data-mobile-footer]');
		if (!(footer instanceof HTMLElement)) return;

		const sidebar = document.querySelector('[data-mobile-sidebar]');
		const toggle = document.querySelector('[data-menu-toggle]');
		const label = toggle?.querySelector('[data-menu-label]');
		const iconOpen = toggle?.querySelector('.mobile-nav__icon-open');
		const iconClose = toggle?.querySelector('.mobile-nav__icon-close');
		let lastScrollY = window.scrollY;
		let open = false;

		function setOpen(next: boolean) {
			open = next;
			sidebar?.classList.toggle('mobile-nav__sidebar--open', open);
			sidebar?.setAttribute('aria-hidden', String(!open));
			footer.style.opacity = '1';
			toggle?.setAttribute('aria-expanded', String(open));
			if (label) label.textContent = open ? 'Close' : 'Menu';
			iconOpen?.toggleAttribute('hidden', open);
			iconClose?.toggleAttribute('hidden', !open);
		}

		toggle?.addEventListener('click', () => setOpen(!open));
		document.querySelectorAll('[data-close-menu]').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});
		window.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && open) setOpen(false);
		});
		window.addEventListener(
			'scroll',
			() => {
				if (open) {
					footer.style.opacity = '1';
					return;
				}
				const y = window.scrollY;
				footer.style.opacity = y > lastScrollY ? '0.5' : '1';
				lastScrollY = y;
			},
			{ passive: true },
		);
	}

	initMobileFooter();
</script>

<style is:global>
	.mobile-nav {
		border-top: .125rem solid var(--color-white);
		background-color: var(--color-primary-dark);
		position: fixed;
		bottom: 0;
		left: 0;
		width: 100%;
		z-index: 50;
		text-align: center;
	}

	.mobile-nav__bar {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		justify-content: center;
	}

	.mobile-nav__link,
	.mobile-nav__toggle {
		background-color: inherit;
		border: .0625rem solid transparent;
		color: var(--color-white);
		position: relative;
		width: 5rem;
		height: 4rem;
		text-align: center;
		transition: color 150ms cubic-bezier(.4, 0, .2, 1);
		z-index: 10;
		cursor: pointer;
		flex: 0 0 calc(100% / var(--mobile-nav-count));
		max-width: calc(100% / var(--mobile-nav-count));
		text-decoration-line: none;
		font-weight: 700;
	}

	.mobile-nav__link:hover,
	.mobile-nav__link:focus,
	.mobile-nav__toggle:hover,
	.mobile-nav__toggle:focus,
	.mobile-nav__link--active {
		color: var(--color-secondary-semidark);
		font-weight: 900;
	}

	.mobile-nav__icon {
		display: flex;
		justify-content: center;
		margin-top: var(--spacing-half);
		height: 1.875rem;
		width: 100%;
	}

	.mobile-nav__glyph {
		width: 1.875rem;
		height: 1.875rem;
	}

	.mobile-nav__glyph path {
		fill: currentColor;
	}

	.mobile-nav__label {
		display: flex;
		justify-content: center;
		width: 100%;
		font-size: .75rem;
		line-height: 1.625;
	}

	.mobile-nav__sidebar {
		background-color: var(--color-primary-dark);
		position: fixed;
		top: 0;
		right: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		height: 100%;
		width: 100%;
		padding-top: var(--spacing-quintuple);
		transition: transform .5s ease-in-out;
		z-index: 5;
		transform: translateX(100%);
	}

	.mobile-nav__sidebar--open {
		transform: translateX(0);
	}

	.mobile-nav__list {
		position: sticky;
		width: inherit;
		z-index: 10;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.mobile-nav__item {
		padding-top: var(--spacing-single);
		padding-bottom: var(--spacing-single);
		padding-left: var(--spacing-triple);
		list-style: none;
		border-bottom: .125rem solid var(--color-white);
	}

	.mobile-nav__sidebar-link {
		display: block;
		color: var(--color-white);
		font-size: 1.375rem;
		width: inherit;
		height: inherit;
	}

	/* Tablet styles */
	@media (width >= 768px) {
		.mobile-nav,
		.mobile-nav__sidebar {
			display: none;
		}
	}
</style>

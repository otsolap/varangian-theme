---
import { isCurrentPath } from '../../lib/path';

interface HeaderLink {
	href: string;
	title: string;
}

interface CallToAction {
	href: string;
	title: string;
}

interface Props {
	title: string;
	slogan?: string;
	links?: HeaderLink[];
	callToAction?: CallToAction;
}

const { title, slogan, links = [], callToAction } = Astro.props;
const path = Astro.url.pathname;
const menuLinks = callToAction ? links.filter((link) => link.href !== callToAction.href) : links;
const ctaCurrent = callToAction ? isCurrentPath(path, callToAction.href) : false;
---

<div class="header">
	<header class="header__bar">
		<div class="header__brand">
			{title && (
				<a class="header__title" href="/">
					{title}
				</a>
			)}
			{slogan && <p class="header__slogan">{slogan}</p>}
		</div>
		{
			callToAction && (
				<a
					class="button button--primary header__cta header__cta--bar"
					href={callToAction.href}
					aria-current={ctaCurrent ? 'page' : undefined}
				>
					{callToAction.title}
				</a>
			)
		}
	</header>
	{
		(menuLinks.length > 0 || callToAction) && (
			<nav class="header__nav" aria-label="Primary">
				<div class="header__nav-inner">
					<div class="header__menu">
						{menuLinks.map((link) => {
							const current = isCurrentPath(path, link.href);
							return (
								<a
									class:list={['header__link', { 'header__link--active': current }]}
									href={link.href}
									aria-current={current ? 'page' : undefined}
								>
									{link.title}
								</a>
							);
						})}
					</div>
					{
						callToAction && (
							<a
								class="button button--primary header__cta"
								href={callToAction.href}
								aria-current={ctaCurrent ? 'page' : undefined}
							>
								{callToAction.title}
							</a>
						)
					}
				</div>
			</nav>
		)
	}
</div>

<style is:global>
	.header {
		position: sticky;
		top: 0;
		z-index: 50;
		background-color: var(--color-primary-dark);
	}

	.header__bar {
		display: flex;
		flex-direction: row;
		min-height: 80px;
		width: 100%;
		padding-left: var(--spacing-half);
		padding-right: var(--spacing-half);
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-half);
		background-color: var(--color-primary-dark);
		border-bottom: 1px solid var(--color-white);
	}

	.header__cta {
		flex: 0 0 auto;
		align-self: center;
		width: fit-content;
		max-width: 12rem;
		white-space: nowrap;
	}

	.header__nav,
	.header__slogan {
		display: none;
	}

	.header__title {
		font-size: 1.25rem;
		margin-bottom: 0;
		font-weight: 900;
		text-shadow: 1px 1px 2px #001f2a;
	}

	@media (width >= 768px) {
		.header__bar {
			flex-direction: column;
			align-items: stretch;
			padding: initial;
			border-bottom: 1px solid var(--color-white);
		}

		.header__cta--bar {
			display: none;
		}

		.header__brand {
			display: flex;
			flex-direction: row;
			align-items: center;
			gap: var(--spacing-double);
			width: 100%;
			max-width: var(--container-desktop);
			margin-inline: auto;
			padding: var(--spacing-half) var(--spacing-double);
		}

		.header__slogan {
			font-weight: 600;
			display: block;
			margin-bottom: 0;
			text-shadow: 1px 1px 2px #001f2a;
		}

		.header__nav {
			display: flex;
			flex-direction: row;
			justify-content: flex-start;
			align-items: center;
			padding: var(--spacing-half);
			background-color: var(--color-primary-dark);
			border-bottom: 1px solid var(--color-white);
		}

		.header__nav-inner {
			display: flex;
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			gap: var(--spacing-double);
			width: 100%;
			max-width: var(--container-desktop);
			margin: 0 auto;
			padding-left: var(--spacing-double);
			padding-right: var(--spacing-double);
		}

		.header__menu {
			display: flex;
			flex-direction: row;
			align-items: center;
			gap: var(--spacing-double);
		}

		.header__link {
			transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1);
			text-shadow: 1px 1px 2px #001f2a;
		}

		.header__link:hover,
		.header__link:focus,
		.header__link--active {
			color: var(--color-secondary-semidark);
			font-weight: 900;
		}
	}

	@media (width >= 1440px) {
		.header__title {
			font-size: 2.5rem;
			margin-bottom: var(--spacing-single);
		}

		.header__link {
			font-size: var(--spacing-double);
		}
	}
</style>

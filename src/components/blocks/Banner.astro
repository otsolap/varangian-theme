---
import AssetImage from '../AssetImage.astro';
import { resolveLocalImage } from '../../lib/images';

interface BannerImage {
	src: string;
	alt: string;
	width?: number;
	height?: number;
}

interface BannerButton {
	href: string;
	title: string;
	selectTheme?: 'primary' | 'secondary' | 'tertiary' | 'link';
	isExternal?: boolean;
	target?: string;
}

interface Props {
	id?: string;
	title?: string;
	description?: string;
	image?: BannerImage;
	button?: BannerButton;
	selectTheme?: 'primary' | 'secondary' | 'tertiary';
}

const {
	id,
	title,
	description,
	image,
	button,
	selectTheme = 'secondary',
} = Astro.props;

const showContent = Boolean(title || description || button?.href);
const external = Boolean(button?.isExternal || button?.target === '_blank');
const localImage = image?.src ? resolveLocalImage(image.src) : undefined;
---

<section class="banner" id={id}>
	<div
		class:list={[
			'banner__inner',
			`bg-${selectTheme}`,
			{ 'color-black': selectTheme === 'primary' },
		]}
	>
		{
			localImage && (
				<figure class="banner__figure">
					<AssetImage
						class="banner__image"
						src={localImage}
						alt={image?.alt ?? ''}
						width={image?.width ?? 150}
						height={image?.height ?? 150}
						layout="fixed"
					/>
				</figure>
			)
		}
		{
			showContent && (
				<div class="banner__content">
					{title && <h2 class="banner__title">{title}</h2>}
					{description && <p class="banner__subtitle">{description}</p>}
					{button?.href && (
						<footer class="banner__actions">
							<a
								class={`button button--${button.selectTheme ?? 'primary'}`}
								href={button.href}
								target={external ? '_blank' : undefined}
								rel={external ? 'noreferrer' : undefined}
							>
								{button.title}
							</a>
						</footer>
					)}
				</div>
			)
		}
	</div>
</section>

<style>
	.banner {
		padding-left: 0;
		padding-right: 0;
	}

	.banner__inner {
		display: flex;
		flex-direction: column;
		padding: var(--spacing-double);
		border-radius: 0;
		border: .0625rem solid transparent;
	}

	.banner__figure {
		position: relative;
		display: flex;
		flex-direction: row;
		justify-content: center;
		margin: 0 auto;
	}

	.banner__content {
		text-align: center;
		padding-top: var(--spacing-single);
		min-width: 0;
	}

	.banner__figure :global(.banner__image) {
		display: block;
		border-radius: 100%;
		height: 9.375rem;
		width: 9.375rem;
		max-width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		object-position: center;
	}

	.banner__actions {
		display: flex;
		justify-content: center;
		padding-top: var(--spacing-single);
		padding-bottom: var(--spacing-double);
		margin: 0 auto;
	}

	/* Tablet styles */
	@media (width >= 768px) {
		.banner__inner {
			flex-direction: row;
			gap: var(--spacing-triple);
		}

		.banner__figure {
			margin: initial;
		}

		.banner__content {
			text-align: initial;
			padding-top: initial;
		}

		.banner__actions {
			justify-content: flex-start;
		}
	}

	/* Desktop styles */
	@media (width >= 1280px) {
		.banner__inner {
			border-radius: var(--spacing-single-quarter);
		}

		.banner:last-child .banner__inner {
			border-bottom-left-radius: 0;
			border-bottom-right-radius: 0;
		}
	}
</style>

---
interface Props {
	title?: string;
	description?: string;
	successMessage?: string;
	errorMessage?: string;
	action?: string;
}

const {
	title,
	description,
	successMessage = 'Message sent. I will get back to you soon.',
	errorMessage = 'The message did not send. Please try again in a moment.',
	action = '/api/contact',
} = Astro.props;

const params = Astro.url.searchParams;
const sent = params.get('sent') === '1';
const errorCode = params.get('error');

const errorText =
	errorCode === 'missing'
		? 'Full name, email, and message are required.'
		: errorCode === 'invalid'
			? 'Check the form fields and try again.'
			: errorCode
				? errorMessage
				: '';
---

<section class="contact-form" id="contact">
	<div class="contact-form__inner">
		<article class="contact-form__body">
			{
				sent ? (
					<div class="contact-form__status contact-form__status--success" role="status">
						<p>{successMessage}</p>
					</div>
				) : (
					<form class="contact-form__form" method="POST" action={action}>
						<header class="contact-form__header">
							{title && <h1 class="contact-form__title">{title}</h1>}
							{description && <p class="contact-form__subtitle">{description}</p>}
						</header>
						{errorText && (
							<div class="contact-form__status contact-form__status--error" role="alert">
								<p>{errorText}</p>
							</div>
						)}
						<div class="contact-form__fields">
							<label class="contact-form__honeypot" aria-hidden="true">
								Company
								<input
									type="text"
									name="company"
									tabindex="-1"
									autocomplete="off"
								/>
							</label>
							<label class="contact-form__field">
								<span class="contact-form__label">Full name</span>
								<input
									class="contact-form__input"
									type="text"
									name="name"
									required
									maxlength="200"
								/>
							</label>
							<label class="contact-form__field">
								<span class="contact-form__label">Email</span>
								<input
									class="contact-form__input"
									type="email"
									name="email"
									required
									maxlength="200"
								/>
							</label>
							<label class="contact-form__field">
								<span class="contact-form__label">Reason for contacting</span>
								<textarea
									class="contact-form__textarea"
									name="message"
									rows="6"
									required
									maxlength="5000"
								/>
							</label>
						</div>
						<footer class="contact-form__footer">
							<button class="button button--primary" type="submit">Send</button>
						</footer>
					</form>
				)
			}
		</article>
	</div>
</section>

<style>
	.contact-form {
		padding-left: 0;
		padding-right: 0;
	}

	.contact-form__inner {
		background-color: var(--color-primary-semidark);
		padding: var(--spacing-double);
		margin: 0 auto;
		width: 100%;
	}

	.contact-form__header {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-single);
		padding-bottom: var(--spacing-single);
	}

	.contact-form__title {
		margin-bottom: 0;
	}

	.contact-form__body,
	.contact-form__form,
	.contact-form__fields {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-single);
		width: 100%;
	}

	.contact-form__footer {
		padding: var(--spacing-single) 0 0;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-single);
	}

	.contact-form__label {
		display: block;
		font-weight: 700;
		margin-bottom: var(--spacing-half);
	}

	.contact-form__field {
		width: 100%;
	}

	.contact-form__input,
	.contact-form__textarea {
		display: block;
		width: 100%;
		max-width: 100%;
		font-size: 1rem;
		color: var(--color-white);
		background-color: var(--color-primary-dark);
		border-radius: var(--spacing-quarter);
		border: .0625rem solid var(--color-primary-light);
		padding: var(--spacing-half) var(--spacing-single);
	}

	.contact-form__input {
		height: 3rem;
	}

	.contact-form__textarea {
		min-height: 10rem;
		resize: vertical;
	}

	.contact-form__input:focus,
	.contact-form__textarea:focus {
		outline: .125rem solid var(--color-secondary);
		outline-offset: .125rem;
	}

	.contact-form__honeypot {
		position: absolute;
		left: -625rem;
		top: auto;
		width: .0625rem;
		height: .0625rem;
		overflow: hidden;
	}

	.contact-form__status {
		width: 100%;
		padding: var(--spacing-single);
		border-radius: var(--spacing-quarter);
	}

	.contact-form__status--success {
		background-color: var(--color-success-dark);
	}

	.contact-form__status--error {
		background-color: var(--color-error-dark);
	}

	/* Desktop styles */
	@media (width >= 1280px) {
		.contact-form__inner {
			max-width: var(--container-desktop);
			border-radius: var(--spacing-single-quarter);
		}
	}
</style>

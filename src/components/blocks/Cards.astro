---
import AssetImage from '../AssetImage.astro';
import { resolveLocalImage } from '../../lib/images';

interface CardImage {
	src: string;
	alt: string;
	width?: number;
	height?: number;
}

interface CardItem {
	id?: string;
	title?: string;
	description?: string;
	image?: CardImage;
}

interface Props {
	id?: string;
	title?: string;
	description?: string;
	cards?: CardItem[];
}

const { id, title, description, cards = [] } = Astro.props;

const items = cards.map((item) => ({
	...item,
	localImage: item.image?.src ? resolveLocalImage(item.image.src) : undefined,
}));
---

<section class="cards" id={id}>
	{
		title && (
			<header class="cards__header">
				{title && <h2 class="cards__title">{title}</h2>}
				{description && <p class="cards__subtitle">{description}</p>}
			</header>
		)
	}
	{
		items.length > 0 && (
			<div class="cards__list">
				{items.map((item) => (
					<article class="card">
						{item.localImage && (
							<figure class="card__figure">
								<AssetImage
									class="card__image"
									src={item.localImage}
									alt={item.image?.alt ?? ''}
									width={item.image?.width ?? 150}
									height={item.image?.height ?? 150}
									layout="fixed"
								/>
							</figure>
						)}
						{(item.title || item.description) && (
							<div class="card__body">
								{item.title && <h3 class="card__title">{item.title}</h3>}
								{item.description && <p class="card__text">{item.description}</p>}
							</div>
						)}
					</article>
				))}
			</div>
		)
	}
</section>

<style>
	.cards {
		background-color: var(--color-primary-dark);
	}

	.cards__header,
	.cards__list {
		display: flex;
		flex-direction: column;
	}

	.cards__header {
		gap: var(--spacing-single);
	}

	.cards__list {
		gap: var(--spacing-single);
		flex-wrap: wrap;
		padding-block: var(--spacing-double);
	}

	.cards:last-child .cards__list {
		padding-bottom: 0;
	}

	.card {
		display: flex;
		flex-direction: column;
		border-radius: var(--spacing-single-quarter);
		border: 1px solid var(--color-white);
		padding: var(--spacing-single);
		width: 100%;
		min-width: 0;
		align-items: center;
		color: var(--color-white);
		transition-duration: 250ms;
	}

	.card:focus,
	.card:hover {
		background-color: var(--color-primary-semidark);
		border-color: var(--color-secondary);
	}

	.card__body {
		flex-grow: 1;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		width: 100%;
	}

	.card__text {
		white-space: pre-line;
		text-align: center;
	}

	.card__figure {
		position: relative;
		margin-top: var(--spacing-single);
		margin-bottom: var(--spacing-double);
	}

	.card__figure :global(.card__image) {
		display: block;
		width: 150px;
		height: 150px;
		max-width: 100%;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		object-position: center;
	}

	.card__title {
		color: var(--color-white);
		font-weight: 600;
		padding-bottom: var(--spacing-single);
		text-align: center;
	}

	@media (width >= 768px) {
		.cards__list {
			flex-direction: row;
		}

		.card {
			max-width: 50%;
			flex: 0 0 calc(50% - var(--spacing-single));
		}
	}

	@media (width >= 1440px) {
		.cards__header {
			max-width: var(--container-ipad-landscape);
			flex: 0 0 50%;
		}

		.cards__list {
			gap: var(--spacing-double);
		}

		.card {
			max-width: calc(100% / 4);
			flex: 0 0 calc(25% - var(--spacing-double));
		}
	}
</style>

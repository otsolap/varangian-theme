---
import AssetImage from '../AssetImage.astro';
import { resolveLocalImage } from '../../lib/images';

interface BlockImage {
	src: string;
	alt: string;
	width?: number;
	height?: number;
}

interface Props {
	id?: string;
	title?: string;
	description?: string | string[];
	image?: BlockImage;
	alignImage?: 'left' | 'right';
}

const {
	id,
	title,
	description,
	image,
	alignImage = 'right',
} = Astro.props;

const paragraphs = Array.isArray(description)
	? description.filter(Boolean)
	: description
		? [description]
		: [];
const showText = Boolean(title || paragraphs.length);
const localImage = image?.src ? resolveLocalImage(image.src) : undefined;
---

<section class="text-and-image" id={id}>
	<div
		class:list={[
			'text-and-image__layout',
			{ 'text-and-image__layout--reverse': alignImage !== 'left' && localImage },
		]}
	>
		{
			localImage && (
				<div class="text-and-image__column">
					<figure class="text-and-image__figure">
						<AssetImage
							class="text-and-image__image"
							src={localImage}
							alt={image?.alt ?? ''}
							width={image?.width ?? 668}
							height={image?.height ?? 500}
						/>
					</figure>
				</div>
			)
		}
		{
			showText && (
				<div class="text-and-image__column">
					{title && <h2 class="text-and-image__title">{title}</h2>}
					{paragraphs.map((paragraph) => (
						<p class="text-and-image__text">{paragraph}</p>
					))}
				</div>
			)
		}
	</div>
</section>

<style>
	.text-and-image {
		position: relative;
		display: flex;
		flex-direction: column;
	}

	.text-and-image__layout {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-single);
	}

	.text-and-image__column {
		display: flex;
		flex-direction: column;
		flex-wrap: wrap;
		width: 100%;
		min-width: 0;
		padding: var(--spacing-single);
		gap: var(--spacing-single);
	}

	.text-and-image__figure {
		position: relative;
		height: 18.75rem;
		width: 18.75rem;
		max-width: 100%;
	}

	.text-and-image__figure :global(.text-and-image__image) {
		border-radius: var(--spacing-single-quarter);
		width: inherit;
		height: inherit;
		max-width: 100%;
		box-shadow: var(--spacing-half) var(--spacing-half) 0 0 var(--color-secondary);
		aspect-ratio: 16 / 9;
		object-fit: cover;
		object-position: center;
	}

	/* Tablet styles */
	@media (width >= 768px) {
		.text-and-image__layout {
			flex-direction: row;
		}

		.text-and-image__layout--reverse {
			flex-direction: row-reverse;
		}

		.text-and-image__column {
			flex: 0 0 50%;
			align-items: flex-start;
			justify-content: center;
		}

		.text-and-image__figure {
			height: 25rem;
			width: 25rem;
		}

		.text-and-image__figure :global(.text-and-image__image) {
			box-shadow: var(--spacing-single) var(--spacing-single) 0 0 var(--color-secondary);
		}
	}

	/* Laptop styles */
	@media (width >= 1024px) {
		.text-and-image__figure {
			width: 100%;
			max-width: calc(100% - 1rem);
			height: auto;
			aspect-ratio: 16 / 9;
		}

		.text-and-image__figure :global(.text-and-image__image) {
			width: 100%;
			height: 100%;
		}
	}

	/* Desktop styles */
	@media (width >= 1280px) {
		.text-and-image__figure {
			max-width: calc(100% - 1.5rem);
		}

		.text-and-image__figure :global(.text-and-image__image) {
			box-shadow: var(--spacing-single-half) var(--spacing-single-half) 0 0 var(--color-secondary);
		}
	}
</style>

---
interface Props {
	id?: string;
	title?: string;
	description?: string;
	placeholder?: string;
	buttonTitle?: string;
	successMessage?: string;
	errorMessage?: string;
	action?: string;
}

const {
	id = 'subscribe',
	title,
	description,
	placeholder = 'Your email',
	buttonTitle = 'Subscribe',
	successMessage = 'Subscription successful. Please check your email to confirm.',
	errorMessage = 'Email failed to submit. Please try again in a few moments.',
	action = '/api/subscribe',
} = Astro.props;
---

<section class="subscribe-form" id={id} data-subscribe>
	<div class="subscribe-form__inner">
		<article class="subscribe-form__body">
			<div
				class="subscribe-form__status subscribe-form__status--success"
				data-subscribe-success
				role="status"
				hidden
			>
				<p>{successMessage}</p>
			</div>
			<form
				class="subscribe-form__form"
				method="POST"
				action={action}
				data-subscribe-form
			>
				<header class="subscribe-form__header">
					{title && <h2 class="subscribe-form__title">{title}</h2>}
					{description && <p class="subscribe-form__subtitle">{description}</p>}
				</header>
				<div
					class="subscribe-form__status subscribe-form__status--error"
					data-subscribe-error
					role="alert"
					hidden
				>
					<p data-subscribe-error-text>{errorMessage}</p>
				</div>
				<div class="subscribe-form__fields">
					<label class="subscribe-form__honeypot" aria-hidden="true">
						Company
						<input type="text" name="company" tabindex="-1" autocomplete="off" />
					</label>
					<label class="subscribe-form__field">
						<span class="subscribe-form__label">Email</span>
						<input
							class="subscribe-form__input"
							type="email"
							name="email"
							placeholder={placeholder}
							required
							maxlength="200"
							autocomplete="email"
						/>
					</label>
					<button
						class="button button--primary subscribe-form__submit"
						type="submit"
						data-subscribe-submit
					>
						{buttonTitle}
					</button>
				</div>
			</form>
		</article>
	</div>
</section>

<script>
	function initSubscribeForm() {
		const root = document.querySelector('[data-subscribe]');
		const form = document.querySelector('[data-subscribe-form]');
		const success = document.querySelector('[data-subscribe-success]');
		const error = document.querySelector('[data-subscribe-error]');
		const errorText = document.querySelector('[data-subscribe-error-text]');
		const submit = document.querySelector('[data-subscribe-submit]');

		if (!(root instanceof HTMLElement) || !(form instanceof HTMLFormElement)) return;
		if (form.dataset.ready === 'true') return;
		form.dataset.ready = 'true';

		function showSuccess() {
			form.hidden = true;
			success?.removeAttribute('hidden');
			error?.setAttribute('hidden', '');
		}

		function showError(message?: string) {
			success?.setAttribute('hidden', '');
			error?.removeAttribute('hidden');
			if (message && errorText) errorText.textContent = message;
		}

		const params = new URLSearchParams(window.location.search);
		if (params.get('subscribed') === '1') {
			showSuccess();
			return;
		}
		if (params.get('error') === 'subscribe') {
			showError();
		}

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (submit instanceof HTMLButtonElement) submit.disabled = true;

			try {
				const response = await fetch(form.action, {
					method: 'POST',
					body: new FormData(form),
					headers: { Accept: 'application/json' },
				});
				const data = await response.json();

				if (data.ok) {
					showSuccess();
					return;
				}

				showError(data.message);
			} catch {
				showError();
			} finally {
				if (submit instanceof HTMLButtonElement) submit.disabled = false;
			}
		});
	}

	initSubscribeForm();
</script>

<style>
	.subscribe-form {
		padding-left: 0;
		padding-right: 0;
	}

	.subscribe-form__inner {
		background-color: var(--color-primary-semidark);
		padding: var(--spacing-double);
		margin: 0 auto;
		width: 100%;
	}

	.subscribe-form__header {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-single);
		padding-bottom: var(--spacing-single);
	}

	.subscribe-form__title {
		margin-bottom: 0;
	}

	.subscribe-form__body,
	.subscribe-form__form {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-single);
		width: 100%;
	}

	.subscribe-form__fields {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: var(--spacing-single);
		width: 100%;
	}

	.subscribe-form__label {
		display: block;
		font-weight: 700;
		margin-bottom: var(--spacing-half);
	}

	.subscribe-form__field {
		width: 100%;
	}

	.subscribe-form__input {
		display: block;
		width: 100%;
		max-width: 100%;
		height: var(--spacing-triple);
		font-size: 1rem;
		font-family: inherit;
		color: var(--color-white);
		background-color: var(--color-primary-dark);
		border-radius: var(--spacing-quarter);
		border: 1px solid var(--color-primary-light);
		padding: var(--spacing-half) var(--spacing-single);
	}

	.subscribe-form__input:focus {
		outline: 2px solid var(--color-secondary);
		outline-offset: 2px;
	}

	.subscribe-form__honeypot {
		position: absolute;
		left: -10000px;
		top: auto;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}

	.subscribe-form__status {
		width: 100%;
		padding: var(--spacing-single);
		border-radius: var(--spacing-quarter);
	}

	.subscribe-form__status--success {
		background-color: var(--color-success-dark);
	}

	.subscribe-form__status--error {
		background-color: var(--color-error-dark);
	}

	@media (width >= 768px) {
		.subscribe-form__fields {
			flex-direction: row;
			align-items: center;
		}

		.subscribe-form__field {
			flex: 1 1 auto;
			max-width: 28rem;
		}

		.subscribe-form__submit {
			align-self: center;
			flex: 0 0 auto;
		}
	}

	@media (width >= 1440px) {
		.subscribe-form__inner {
			max-width: var(--container-desktop);
			border-radius: var(--spacing-single-quarter);
		}
	}
</style>

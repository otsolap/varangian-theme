---
import AssetImage from '../AssetImage.astro';
import { resolveLocalImage } from '../../lib/images';

interface HeroImage {
	src: string;
	alt: string;
	width?: number;
	height?: number;
}

interface HeroButton {
	href: string;
	title: string;
	selectTheme?: 'primary' | 'secondary' | 'tertiary' | 'link';
	isExternal?: boolean;
	target?: string;
}

interface Props {
	title?: string;
	description?: string;
	image?: HeroImage;
	buttons?: HeroButton[];
	mediaWidth?: boolean;
	alignImage?: 'left' | 'right';
}

const { title, description, image, buttons = [], mediaWidth = false, alignImage = 'left' } = Astro.props;

const visibleButtons = buttons.filter((button) => button.href);
const localImage = image?.src ? resolveLocalImage(image.src) : undefined;
---

<div
	class:list={[
		'hero',
		{
			'hero--with-image': localImage,
			'hero--full': mediaWidth,
			'hero--image-right': alignImage === 'right' && !mediaWidth,
		},
	]}
>
	{
		localImage && (
			<div class:list={['hero__media', { 'hero__media--full': mediaWidth }]}>
				<AssetImage
					class="hero__image"
					src={localImage}
					alt={image?.alt ?? ''}
					width={image?.width ?? (mediaWidth ? 1440 : 720)}
					height={image?.height ?? 560}
					priority
				/>
			</div>
		)
	}
	<div class="hero__content">
		<article class="hero__body">
			{title && <h1 class="hero__title">{title}</h1>}
			{description && <h2 class="hero__subtitle">{description}</h2>}
			{
				visibleButtons.length > 0 && (
					<div class="hero__actions">
						{visibleButtons.map((button) => {
							const external = button.isExternal || button.target === '_blank';
							return (
								<a
									class={`button button--${button.selectTheme ?? 'primary'}`}
									href={button.href}
									target={external ? '_blank' : undefined}
									rel={external ? 'noreferrer' : undefined}
								>
									{button.title}
								</a>
							);
						})}
					</div>
				)
			}
		</article>
	</div>
</div>

<style>
	.hero {
		background-color: var(--color-primary-dark);
		color: var(--color-white);
		margin-top: 0;
		margin-left: auto;
		margin-right: auto;
		margin-bottom: var(--spacing-double);
		width: 100%;
		max-width: 100%;
		position: relative;
		display: flex;
		flex-direction: column;
	}

	.hero__media {
		position: relative;
		height: auto;
		width: 100%;
		max-width: 100%;
		min-width: 0;
		border-radius: inherit;
	}

	.hero__media :global(.hero__image) {
		display: block;
		width: 100%;
		max-width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		object-position: center;
	}

	.hero__content {
		width: 100%;
		display: flex;
		flex-direction: row;
		flex-wrap: nowrap;
		align-items: center;
		justify-content: flex-start;
		position: relative;
		min-width: 0;
	}

	.hero__body {
		padding: var(--spacing-single);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-single);
	}

	.hero__body *:not(a):not(.button) {
		text-shadow: 1px 1px 2px var(--color-primary-dark);
	}

	.hero__title {
		font-size: 3rem;
		margin-bottom: initial;
		overflow-wrap: break-word;
		text-wrap: wrap;
	}

	.hero__subtitle {
		font-size: 1rem;
		font-weight: 500;
		margin-bottom: initial;
		text-wrap: wrap;
	}

	.hero__actions {
		display: flex;
		flex-direction: column;
		flex-wrap: wrap;
		gap: var(--spacing-single-half);
		padding-bottom: var(--spacing-single);
		width: fit-content;
	}

	@media (width >= 768px) {
		.hero--with-image {
			flex-direction: row;
			position: relative;
			height: 561px;
			max-height: 561px;
		}

		.hero--with-image .hero__media,
		.hero--with-image .hero__content {
			flex: 0 0 50%;
			width: 50%;
			max-width: 50%;
		}

		.hero--with-image .hero__media {
			height: 561px;
			max-height: 561px;
			overflow: hidden;
		}

		.hero__media :global(.hero__image) {
			width: 100%;
			height: 100%;
			max-width: none;
			aspect-ratio: 1 / 1;
			object-fit: cover;
			object-position: center;
		}

		.hero__body {
			padding: var(--spacing-double);
			gap: var(--spacing-single-half);
		}

		.hero__actions {
			flex-direction: row;
			gap: var(--spacing-single);
			width: fit-content;
		}

		.hero--image-right {
			flex-direction: row-reverse;
		}

		.hero--full .hero__content {
			z-index: 1;
		}

		.hero--full.hero--with-image .hero__media {
			position: absolute;
			inset: 0;
			flex: none;
			width: 100%;
			max-width: 100%;
			height: 561px;
			max-height: 561px;
			overflow: hidden;
		}

		.hero--full .hero__media :global(.hero__image) {
			width: 100%;
			height: 561px;
			max-height: 561px;
			aspect-ratio: 16 / 9;
			border-radius: inherit;
			object-fit: cover;
		}
	}

	@media (width >= 1440px) {
		.hero {
			max-width: var(--container-desktop);
			border-bottom-right-radius: var(--spacing-single-quarter);
			border-bottom-left-radius: var(--spacing-single-quarter);
			margin-bottom: var(--spacing-triple);
			overflow: hidden;
		}

		.hero--with-image .hero__media {
			max-height: initial;
		}

		.hero__title {
			font-size: 3.5rem;
			padding-bottom: var(--spacing-single);
		}

		.hero__subtitle {
			font-size: 1.5rem;
			padding-bottom: var(--spacing-single);
		}
	}
</style>

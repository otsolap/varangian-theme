---
interface Props {
	id?: string;
	title?: string;
	author?: string;
	source?: string;
}

const { id, title, author, source } = Astro.props;
const show = Boolean(title);
---

{
	show && (
		<section class="quote" id={id}>
			<figure class="quote__figure">
				<blockquote class="quote__block">
					<svg
						class="quote__mark"
						viewBox="0 0 40.9 26.6"
						fill="currentColor"
						aria-hidden="true"
					>
						<path d="M40.9 0H26.6L20 26.6h9.8L40.9 0zM20.8 0H6.6L0 26.6h9.8L20.8 0z" />
					</svg>
					<p class="quote__text">{title}</p>
					<svg
						class="quote__mark quote__mark--end"
						viewBox="0 0 40.9 26.6"
						fill="currentColor"
						aria-hidden="true"
					>
						<path d="M40.9 0H26.6L20 26.6h9.8L40.9 0zM20.8 0H6.6L0 26.6h9.8L20.8 0z" />
					</svg>
				</blockquote>
				{(author || source) && (
					<figcaption class="quote__source">
						{author && <span>{author}</span>}
						{source && <cite class="quote__cite">- {source}</cite>}
					</figcaption>
				)}
			</figure>
		</section>
	)
}

<style>
	.quote {
		max-width: var(--container-ipad);
	}

	.quote__figure {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-single);
	}

	.quote__block {
		display: flex;
		flex-direction: column;
		justify-content: center;
		position: relative;
		width: 100%;
		padding: var(--spacing-single);
		gap: var(--spacing-single);
	}

	.quote__text {
		font-style: italic;
	}

	.quote__mark {
		width: 1.25rem;
		height: auto;
		flex-shrink: 0;
	}

	.quote__block > .quote__mark:first-child {
		margin-right: auto;
	}

	.quote__mark--end {
		margin-left: auto;
		transform: scaleX(-1);
	}

	.quote__source {
		display: flex;
		flex-direction: column;
		text-align: center;
		gap: var(--spacing-half);
	}

	/* Tablet styles */
	@media (width >= 768px) {
		.quote__block {
			flex-direction: row;
			align-items: center;
		}

		.quote__text {
			font-size: 1rem;
		}

		.quote__mark,
		.quote__block > .quote__mark:first-child,
		.quote__mark--end {
			width: 1.5rem;
			margin: 0;
		}

		.quote__source {
			flex-direction: row;
			justify-content: center;
		}
	}
</style>

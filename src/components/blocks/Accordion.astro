---
interface AccordionItem {
	title: string;
	description?: string;
	open?: boolean;
}

interface Props {
	id?: string;
	title?: string;
	description?: string;
	accordions?: AccordionItem[];
}

const { id, title, description, accordions = [] } = Astro.props;
const show = Boolean(title || description || accordions.length);
---

{
	show && (
		<section class="accordion" id={id}>
			{(title || description) && (
				<header class="accordion__header">
					{title && <h2 class="accordion__title">{title}</h2>}
					{description && <p class="accordion__subtitle">{description}</p>}
				</header>
			)}
			<div class="accordion__layout">
				<div class="accordion__list">
					{accordions.map((item) => (
						<div
							class:list={['accordion__item', { 'accordion__item--open': item.open }]}
							data-accordion-item
						>
							<button
								class="accordion__trigger"
								type="button"
								aria-expanded={item.open ? 'true' : 'false'}
								data-accordion-toggle
							>
								<h4 class="accordion__heading">{item.title}</h4>
								<svg
									class:list={[
										'accordion__icon',
										item.open ? 'accordion__icon--open' : null,
									]}
									viewBox="0 0 24 24"
									width="1.875rem"
									height="1.875rem"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									aria-hidden="true"
									data-accordion-icon
								>
									<path d="M6 9l6 6 6-6"></path>
								</svg>
							</button>
							<div
								class:list={['accordion__panel', { 'accordion__panel--open': item.open }]}
								data-accordion-answer
							>
								<p class="accordion__text">{item.description}</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>
	)
}

<script>
	function initAccordion() {
		document.querySelectorAll('[data-accordion-item]').forEach((item) => {
			if (!(item instanceof HTMLElement)) return;
			if (item.dataset.accordionReady === 'true') return;
			item.dataset.accordionReady = 'true';

			const toggle = item.querySelector('[data-accordion-toggle]');
			const answer = item.querySelector('[data-accordion-answer]');
			const icon = item.querySelector('[data-accordion-icon]');
			if (!(answer instanceof HTMLElement)) return;

			function setOpen(open: boolean) {
				item.classList.toggle('accordion__item--open', open);
				answer.classList.toggle('accordion__panel--open', open);
				icon?.classList.toggle('accordion__icon--open', open);
				toggle?.setAttribute('aria-expanded', String(open));
				answer.style.maxHeight = open ? `${answer.scrollHeight}px` : '0px';
			}

			setOpen(item.classList.contains('accordion__item--open'));
			toggle?.addEventListener('click', () => {
				setOpen(toggle.getAttribute('aria-expanded') !== 'true');
			});
		});
	}

	initAccordion();
</script>

<style>
	.accordion__header {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-single);
		padding-bottom: var(--spacing-double);
	}

	.accordion__layout {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-single);
		width: 100%;
	}

	.accordion__list {
		max-width: 100%;
		width: 100%;
		border: .125rem solid transparent;
		border-radius: var(--spacing-single-quarter);
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
	}

	.accordion__item {
		border: .0625rem solid var(--color-white);
		transition: background-color .2s ease;
		width: 100%;
		background-color: var(--color-primary-dark);
	}

	.accordion__item--open {
		background-color: var(--color-secondary-semidark);
		color: var(--color-black);
	}

	.accordion__item--open .accordion__heading {
		font-weight: 900;
	}

	.accordion__trigger {
		display: flex;
		align-items: center;
		background-color: inherit;
		width: 100%;
		border: 0;
		padding: 0;
		color: inherit;
		cursor: pointer;
		text-align: left;
		font: inherit;
	}

	.accordion__heading {
		color: inherit;
		font-weight: 700;
		margin-left: var(--spacing-single);
		padding-top: var(--spacing-single);
		padding-bottom: var(--spacing-single);
		margin-bottom: 0;
	}

	.accordion__icon {
		background-image: none;
		cursor: pointer;
		margin-right: var(--spacing-single);
		margin-left: auto;
		width: 1.875rem;
		height: 1.875rem;
		line-height: 2.25rem;
		background-color: inherit;
		color: inherit;
		flex-shrink: 0;
		transition: transform .6s ease-in-out;
	}

	.accordion__icon--open {
		transform: rotate(90deg);
	}

	.accordion__panel {
		transition: max-height .6s ease;
		max-height: 0;
		overflow: hidden;
		background-color: var(--color-primary);
		color: var(--color-white);
		padding-left: var(--spacing-half);
	}

	.accordion__panel--open {
		border-color: var(--color-white);
		border-top-width: .125rem;
		border-top-style: solid;
	}

	.accordion__text {
		padding: var(--spacing-single) var(--spacing-half);
	}

	/* Desktop styles */
	@media (width >= 1280px) {
		.accordion__header {
			max-width: var(--container-ipad-landscape);
			flex: 0 0 50%;
		}

		.accordion__layout {
			flex-direction: row;
			gap: var(--spacing-double);
		}

		.accordion__list {
			max-width: 50%;
			flex: 0 0 50%;
		}

		.accordion__text {
			padding: var(--spacing-double) var(--spacing-single);
		}
	}
</style>

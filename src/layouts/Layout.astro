---
import '../styles/global.css';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/navigation/Footer.astro';
import MobileFooter from '../components/navigation/MobileFooter.astro';
import Seo from '../components/Seo.astro';

interface NavLink {
	href: string;
	title: string;
	icon?: string;
	isExternal?: boolean;
}

interface Props {
	pageTitle: string;
	description?: string;
	robots: string;
	canonical?: string;
	siteName: string;
	locale?: string;
	imageUrl?: string;
	imageAlt?: string;
	imageWidth?: number;
	imageHeight?: number;
	twitterSite?: string;
	jsonLd?: string;
	sitemapHref?: string;
	lang?: string;
	favicon?: string;
	navigation: {
		header: {
			title: string;
			slogan?: string;
			links?: NavLink[];
			callToAction?: {
				href: string;
				title: string;
			};
		};
		footer: {
			social?: {
				title?: string;
				links?: NavLink[];
			};
			brand?: {
				title?: string;
				description?: string;
			};
			subFooter?: {
				title?: string;
				link?: NavLink;
			};
		};
	};
}

const { lang = 'en', favicon = '/favicon.png', navigation, ...seo } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={favicon} />
		<meta name="generator" content={Astro.generator} />
		<Seo {...seo} />
	</head>
	<body>
		<Header {...navigation.header} />
		<slot />
		<Footer {...navigation.footer} />
		<MobileFooter links={navigation.header.links} />
	</body>
</html>
